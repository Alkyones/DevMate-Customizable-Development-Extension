{
  "manifest_version": 3,
  "name": "DevMate AI",
  "short_name": "DevMate AI",
  "version": "2.0",
  "description": "AI-powered developer toolkit - Local storage viewer, credential manager, code keeper, API pinger, and more.",
  "permissions": ["activeTab", "scripting", "webRequest", "storage", "contextMenus"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["scripts/content/autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "functions.js", 
        "db.js",
        "scripts/config/constants.js",
        "scripts/ui/dom-utils.js",
        "scripts/ui/snackbar.js",
        "scripts/ui/panel-manager.js",
        "scripts/features/credential-generator.js",
        "scripts/features/local-storage.js",
        "scripts/features/useful-links.js",
        "scripts/features/credentials.js",
        "scripts/features/fetch-capture.js",
        "scripts/features/code-keeper.js",
        "scripts/features/pinger.js"
      ],
      "matches": ["*://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
